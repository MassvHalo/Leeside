APP_NAME=Leeside
APP_ENV=production
APP_DEBUG=false
APP_URL=https://webapp.leeside.halowifi.com
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/leeside/leeside-sample/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

LEESIDE_EVENTS_SOCKET=/run/leeside/events.sock
LEESIDE_CHECK_SOCKET=/run/leeside/check.sock
LEESIDE_HASH_KEY=
# Signs the Leeside tag cookie. Set it explicitly: when it falls back to APP_KEY,
# a key rotation invalidates every issued tag at once and reads as a bad_mac wave.
LEESIDE_TAG_SECRET=
# deploy/header-order-check.sh: php-fpm reverses header order here, so names hash sorted.
LEESIDE_HEADER_ORDER_RELIABLE=false
LEESIDE_SAMPLE_RATE=1.0
