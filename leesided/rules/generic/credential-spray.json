{
  "id": "credential-spray",
  "note": "Five rejected credentials within ten minutes from one peer",
  "mode": "enforce",
  "action": "rate_limit",
  "retry_after_s": 300,
  "match": {
    "route": ["*"],
    "verb": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"],
    "principal": "any",
    "surface": ["api", "webhook"]
  },
  "when": {
    "scope": "peer",
    "window_s": 600,
    "distinct": { "field": "credential", "where": { "credential_status": ["rejected"] } },
    "gte": 5
  },
  "origin": { "kind": "install" }
}
