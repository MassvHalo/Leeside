{"patterns": [
  {"class": "sqli", "pattern": "'\\s*(or|and)\\s+\\d+\\s*=\\s*\\d+"},
  {"class": "sqli", "pattern": "'\\s*(or|and)\\s+'[^']*'\\s*=\\s*'"},
  {"class": "sqli", "pattern": "union\\s+.*select"},
  {"class": "sqli", "pattern": "select\\s+.+\\s+from\\s+"},
  {"class": "sqli", "pattern": "--(\\s|$)|/\\*"},
  {"class": "sqli", "pattern": ";\\s*(drop|delete|insert|update|exec|execute)\\s+"},
  {"class": "sqli", "pattern": "(benchmark|sleep|pg_sleep|waitfor)\\s*\\("},
  {"class": "sqli", "pattern": "0x[0-9a-f]{4,}"},
  {"class": "xss", "pattern": "<\\s*script\\b"},
  {"class": "xss", "pattern": "javascript\\s*:"},
  {"class": "xss", "pattern": "\\bon(load|error|click|dblclick|mouseover|mouseout|focus|blur|submit|change|input|keydown|keyup|keypress)\\s*="},
  {"class": "xss", "pattern": "<\\s*(img|svg|iframe|body|object|embed)\\b"},
  {"class": "xss", "pattern": "(alert|confirm|prompt)\\s*\\("},
  {"class": "xss", "pattern": "document\\.(cookie|domain|write)"},
  {"class": "xss", "pattern": "&#[xX]?[0-9a-fA-F]+;"},
  {"class": "traversal", "pattern": "\\.\\./|\\.\\.\\\\"},
  {"class": "traversal", "pattern": "%2e%2e|\\.\\.%2f|%252e"},
  {"class": "traversal", "pattern": "/etc/(passwd|shadow|hosts|group)"},
  {"class": "traversal", "pattern": "%c0%af|%c1%9c"},
  {"class": "traversal", "pattern": "boot\\.ini|win\\.ini"},
  {"class": "ssti", "pattern": "\\{\\{.+\\}\\}"},
  {"class": "ssti", "pattern": "\\$\\{.+\\}"},
  {"class": "ssti", "pattern": "%7b%7b.+%7d%7d"},
  {"class": "ssti", "pattern": "\\{%.+%\\}"},
  {"class": "ssti", "pattern": "#\\{.+\\}"},
  {"class": "cmdi", "pattern": ";\\s*\\b(cat|ls|id|whoami|uname|pwd|env|echo|rm|cp|mv)\\b"},
  {"class": "cmdi", "pattern": "\\|\\s*\\b(cat|ls|id|whoami|nc|sh|bash|tee)\\b"},
  {"class": "cmdi", "pattern": "`[^`\\s]+`"},
  {"class": "cmdi", "pattern": "\\$\\([^)]+\\)"},
  {"class": "cmdi", "pattern": "\\b(curl|wget)\\s+https?://"},
  {"class": "cmdi", "pattern": "/bin/(sh|bash)"}
]}
