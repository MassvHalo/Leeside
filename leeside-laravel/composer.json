{
    "name": "leeside/laravel",
    "description": "Leeside capture layer for Laravel: PII-free turn events and deterministic rule gating.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/log": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Leeside\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Leeside\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Leeside\\Laravel\\LeesideServiceProvider"
            ]
        }
    },
    "suggest": {
        "ext-sockets": "Required to run php artisan leeside:tap."
    },
    "scripts": {
        "test": "vendor/bin/phpunit --colors=never"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
